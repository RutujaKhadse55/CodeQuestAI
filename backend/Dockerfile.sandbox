# Sandbox service image: stdlib only, no secrets, no packages. Build from the repo root:
#   docker build -f backend/Dockerfile.sandbox -t codequest-sandbox .
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /srv
COPY backend/app app
RUN useradd --system --uid 10002 --no-create-home sandbox
USER sandbox
EXPOSE 9000
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:9000/health')"
CMD ["python", "-m", "app.engine.sandbox.server"]
