{
  "manifest_version": 3,
  "name": "CodeQuest AI",
  "version": "0.1.0",
  "description": "AI coding mentor for LeetCode",
  "permissions": ["storage", "contextMenus", "offscreen"],
  "host_permissions": ["https://leetcode.com/*", "http://localhost:8000/*"],
  "background": {"service_worker": "src/background/service_worker.ts", "type": "module"},
  "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["src/content/toolbar.ts"]}],
  "options_page": "src/options/index.html"
}
