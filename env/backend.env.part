API_TOKEN=change-me
CORS_ORIGINS=chrome-extension://<extension-id>
MOCK=0
USE_REAL_ENGINE=1
SANDBOX_MODE=auto
DAILY_ANALYZE_CAP=300
RATE_LIMIT_PER_MIN=60
# LeetCode profile RAG (set real values only in your untracked .env)
FEATURE_PROFILE_RAG=0
CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROFILE_SYNC_MIN_INTERVAL_S=600
SANDBOX_URL=http://sandbox:9000
SANDBOX_TOKEN=sandbox-dev-token
# Problem chat + consent
FEATURE_CHAT=0
REQUIRE_USER_TOKEN=0
PROFILE_SNAPSHOT_DIR=./data/profiles
FEATURE_DEV_UI=0
